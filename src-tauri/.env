# Compile-time SQLx settings (read by cargo on every platform).
# The sqlx::query! macros are verified against this dev DB's schema at build time.
# Create it once with scripts/setup-windows.ps1 (or `sqlx database setup` in this dir).
# This DB is used ONLY at compile time — the app creates its own DB in the
# app-data dir at runtime.
DATABASE_URL=sqlite:./alfred_dev.db
# Online verification (against the DB above). Set to true only if you have
# generated the .sqlx offline cache via `cargo sqlx prepare`.
SQLX_OFFLINE=false
